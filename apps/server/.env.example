# ===================================================================
# Backend reads configuration from the PROJECT ROOT .env
# (i.e. ../../.env relative to this server/ directory).
# This file is a TEMPLATE only -- it contains no real secrets.
#
# To configure: copy these values into the root .env and adjust.
# The root .env is shared by both the frontend and this backend.
# ===================================================================

# DeepSeek API key (OpenAI-compatible protocol).
OPENAI_API_KEY=sk-your-deepseek-key-here

# OpenAI-compatible base URL for DeepSeek.
OPENAI_BASE_URL=https://api.deepseek.com

# Default model name.
# NOTE: If "deepseek-v4-flash" returns a "model not found" error
# from DeepSeek, switch this to "deepseek-chat".
OPENAI_MODEL=deepseek-v4-flash

# Backend server port (Vite dev proxy targets this port).
PORT=3001
