# ===================================================================
# Backend reads configuration from the PROJECT ROOT .env
# (i.e. ../../.env relative to this server/ directory).
# This file is a TEMPLATE only -- it contains no real secrets.
#
# To configure: copy these values into the root .env and adjust.
# The root .env is shared by both the frontend and this backend.
# ===================================================================

# DeepSeek API key (OpenAI-compatible protocol).
OPENAI_API_KEY=sk-your-deepseek-key-here

# OpenAI-compatible base URL for DeepSeek.
OPENAI_BASE_URL=https://api.deepseek.com

# Default model name.
# NOTE: If "deepseek-v4-flash" returns a "model not found" error
# from DeepSeek, switch this to "deepseek-chat".
OPENAI_MODEL=deepseek-v4-flash

# Backend server port (Vite dev proxy targets this port).
PORT=3001

# Agent loop caps (per user turn). On the last allowed step all tools are
# disabled and the model must close with a text summary (no more dangling
# tool results). AGENT_FAILURE_THRESHOLD trips the circuit breaker after N
# consecutive tool failures or N identical (tool,args) repeat calls.
# AGENT_MAX_STEPS=20
# AGENT_FAILURE_THRESHOLD=3

# Conversation history auto-compaction (token-governed; NO round cap).
# After a run whose TOTAL usage crosses WINDOW - RESERVE, older turns are
# LLM-summarized (structured summary; business ids preserved verbatim) and
# later turns send [summary + recent tail] instead of full history.
# AGENT_CONTEXT_WINDOW_TOKENS=65536
# AGENT_COMPACT_RESERVE_TOKENS=16384
# AGENT_COMPACT_KEEP_MESSAGES=20

# 本公司主体名单(逗号分隔), 四流方向判定基准。
# 资金流按付款人/收款人、货物流按买方/卖方、发票流按开票方/受票方,
# 锚点命中名单一侧即判定 收(in)/付(out)。OCR 写法变体请多列别名。
# 未配置时方向语义关闭(执行流水不物化)。
# SELF_PARTY_NAMES=华能电厂,华能电力集团

# Optional SiliconFlow hosted models; setting SILICONFLOW_API_KEY enables
# SiliconFlow bge-m3 embeddings + bge-reranker-v2-m3 rerank for vector recall.
SILICONFLOW_API_KEY=
SILICONFLOW_BASE_URL=https://api.siliconflow.cn
SILICONFLOW_EMBED_MODEL=BAAI/bge-m3
SILICONFLOW_RERANK_MODEL=BAAI/bge-reranker-v2-m3

# Scanned-document OCR backend for parseDocument.
#   mineru     (default) local MinerU CLI, CPU, no key needed
#   qianfan    Baidu Qianfan hosted PaddleOCR-VL (document goes to Baidu cloud;
#              PDF <= 50MB / image <= 10MB per request)
#   mineru-api MinerU cloud API at mineru.net (document goes to OpenDataLab
#              cloud; <= 200MB / <= 200 pages; async upload + poll)
# PARSE_BACKEND=mineru
# Required only when PARSE_BACKEND=qianfan (API Key from Qianfan console).
# QIANFAN_API_KEY=
# QIANFAN_OCR_URL=https://qianfan.baidubce.com/v2/ocr/paddleocr
# QIANFAN_TIMEOUT_MS=300000
# Required only when PARSE_BACKEND=mineru-api (Token from mineru.net API 管理页).
# MINERU_API_KEY=
# MINERU_API_BASE_URL=https://mineru.net/api/v4
# MINERU_API_TIMEOUT_MS=600000
# MINERU_API_MODEL_VERSION=pipeline

# 批量拆分器(一个物理文件 != 一份业务单据, spec 2026-09-01)。
#   BATCH_SPLIT_ENABLED  灰度总开关, 默认 false = 完全走旧路径零行为变化。
#   BATCH_SPLIT_CONCURRENCY  逐页 VLM 版面清点并发数, 默认 4。
#   BATCH_SPLIT_MAX_PAGES  参与检测的最大 PDF 页数, 超过走旧路径, 默认 50。
# 需要 VLM_BASE_URL / VLM_API_KEY 已配置; 未配置时拆分自动不生效。
# BATCH_SPLIT_ENABLED=true
# BATCH_SPLIT_CONCURRENCY=4
# BATCH_SPLIT_MAX_PAGES=50
